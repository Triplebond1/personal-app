{
  "name": "personal-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail=false --names frontend,backend \"npm:dev:frontend\" \"npm:dev:backend\"",

    "dev:frontend": "next dev",
    "dev:backend": "tsx watch server/src/server.ts",

    "build": "next build",

    "start": "concurrently --kill-others-on-fail=false --names frontend,backend \"npm:start:frontend\" \"npm:start:backend\"",

    "start:frontend": "next start",
    "start:backend": "tsx server/src/server.ts",

    "lint": "eslint .",

    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
  },
  
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "axios": "^1.20.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "crypto-random-string": "^5.0.0",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "figlet": "^1.11.4",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "next": "16.3.3",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/figlet": "^1.7.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "nodemon": "^3.1.14",
    "pm2": "^7.0.4",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
